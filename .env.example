# === Zalo Sales CRM — cấu hình (sao chép thành .env) ===
# Sinh secret ngẫu nhiên (chạy 2 lần, mỗi giá trị một lần):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# hoặc:  openssl rand -hex 32
# Ứng dụng TỪ CHỐI khởi động nếu JWT_SECRET / ENCRYPTION_KEY trống hoặc < 32 ký tự.

PORT=3000
NODE_ENV=production

# Địa chỉ trình duyệt dùng để mở ứng dụng (CORS + Socket.IO chỉ chấp nhận origin này).
# Chạy trên máy cá nhân: http://localhost:3080
APP_URL=http://localhost:3080
# Thêm origin khác nếu cần, phân tách bằng dấu phẩy. Ví dụ: http://192.168.1.10:3080
CORS_ORIGINS=

# Chỉ cho Docker lắng nghe trên loopback (127.0.0.1). Đặt 0.0.0.0 nếu muốn mở ra LAN (chỉ mạng tin cậy).
BIND_ADDR=127.0.0.1
APP_PORT=3080
# Đặt true nếu chạy sau reverse proxy (nginx/cloudflared) để rate-limit nhận đúng IP khách.
TRUST_PROXY=false

# Security — BẮT BUỘC, mỗi giá trị tối thiểu 32 ký tự
JWT_SECRET=
ENCRYPTION_KEY=
# Thời hạn token đăng nhập (mặc định 1d). Ví dụ: 12h, 1d, 7d
JWT_EXPIRES_IN=1d

# Database
DB_USER=crmuser
DB_PASSWORD=
DB_NAME=zalocrm

# Storage
UPLOAD_DIR=/var/lib/zalo-crm/files

# Tính năng tích hợp — tắt nếu không dùng để giảm bề mặt tấn công
PUBLIC_API_ENABLED=true
WEBHOOKS_ENABLED=true
# Cho phép webhook trỏ tới địa chỉ nội bộ/LAN (mặc định chặn để chống SSRF)
WEBHOOK_ALLOW_PRIVATE=false

# Địa chỉ MCP hiển thị cho Claude Code (mặc định APP_URL/mcp khi production)
MCP_PUBLIC_URL=
