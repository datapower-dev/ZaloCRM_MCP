# Backend chạy trực tiếp (không Docker) — sao chép thành backend/.env
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_URL=http://localhost:5173

# BẮT BUỘC, tối thiểu 32 ký tự mỗi giá trị:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=1d

DATABASE_URL=postgresql://crmuser:password@localhost:5433/zalocrm

UPLOAD_DIR=/var/lib/zalo-crm/files

PUBLIC_API_ENABLED=true
WEBHOOKS_ENABLED=true
WEBHOOK_ALLOW_PRIVATE=false
